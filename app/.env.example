# Local synthetic workspace; no live adapters are enabled in this milestone.
# Never commit real credentials. No values are required to explore the app.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# AI remains off until access, model availability/pricing and an allowance are agreed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
NALBACE_AI_ENABLED=false
# Lifetime request count in the local workspace, including failures. 0 disables usage.
# At most 20, with 600 output tokens and bounded context per request; not a dollar cap.
NALBACE_AI_MAX_REQUESTS=0
# Email, hosted authentication and voice setup follow separately.

# Optional controlled email test. All fields and explicit separate approval required.
# One exact owner-controlled email; no real customer list or automatic retries.
RESEND_API_KEY=
NALBACE_EMAIL_ENABLED=false
NALBACE_EMAIL_MAX_ATTEMPTS=0
NALBACE_EMAIL_FROM=
NALBACE_EMAIL_TEST_RECIPIENT=

# Gmail is a separate Nalbace OAuth connection, not ChatGPT's Gmail plugin.
# Register a Google Web application with this exact local redirect URI:
# http://127.0.0.1:3000/api/gmail-connection/callback
# Request only openid, email and gmail.send. Keep the app in testing.
NALBACE_GMAIL_CLIENT_ID=
NALBACE_GMAIL_CLIENT_SECRET=
NALBACE_GMAIL_ACCOUNT=
# Random 32-byte key encoded as base64; server-only. Never commit it.
NALBACE_GMAIL_STORAGE_KEY=
# Explicitly select gmail only when configuring its own authorized test.
# NALBACE_EMAIL_PROVIDER=gmail

# Optional SES sandbox transport. Dedicated least-privilege app credentials;
# never use root keys. Fixed Ohio endpoint; no ambient AWS credential lookup.
# NALBACE_EMAIL_PROVIDER=ses
NALBACE_SES_ACCESS_KEY_ID=
NALBACE_SES_SECRET_ACCESS_KEY=
NALBACE_SES_SESSION_TOKEN=
# Sending and all spending gates above/below remain disabled by default.

# Additional deployment-wide and per-business monthly safeguards (UTC months).
# Zero/defaults block dispatch; these do NOT authorize new paid requests.
# 1 USD = 1,000,000 integer micro USD. Each action reserves its full configured
# maximum, which must cover tokens/reasoning, fees and provider billing rules.
NALBACE_SPEND_ENABLED=false
NALBACE_SPEND_RATE_CARD=
# ISO timestamp; expires fail-closed until rates are reviewed.
NALBACE_SPEND_VALID_UNTIL=
NALBACE_SPEND_APPLICATION_MICRO_USD=0
NALBACE_SPEND_MERCHANT_MICRO_USD=0
NALBACE_SPEND_AI_REQUESTS=0
NALBACE_SPEND_EMAIL_ATTEMPTS=0
NALBACE_SPEND_VOICE_SECONDS=0
NALBACE_SPEND_AI_MODEL=
NALBACE_SPEND_EMAIL_PROVIDER=
NALBACE_SPEND_VOICE_PROVIDER=
NALBACE_SPEND_AI_MAX_MICRO_USD=0
NALBACE_SPEND_EMAIL_MAX_MICRO_USD=0
NALBACE_SPEND_VOICE_MAX_MICRO_USD=0

# Retell phone integration remains unfinished; no dispatch endpoint is enabled.
# Saving these fields does not authorize key creation, spending or calls.
NALBACE_RETELL_API_KEY=
NALBACE_RETELL_AGENT_ID=
# Pin a published numeric version; never latest/draft for an approved call.
NALBACE_RETELL_AGENT_VERSION=
NALBACE_VOICE_FROM=
NALBACE_VOICE_TEST_RECIPIENT=
NALBACE_VOICE_ENABLED=false
NALBACE_VOICE_INTEGRATION_READY=false
NALBACE_VOICE_MAX_ATTEMPTS=0

# Monitored reply destination. Sender verification alone does not create an inbox.
NALBACE_EMAIL_REPLY_TO=

# Separate read-only reply mailbox OAuth app; never reuse the send grant.
NALBACE_INBOX_CLIENT_ID=
NALBACE_INBOX_CLIENT_SECRET=
NALBACE_INBOX_ACCOUNT=
NALBACE_INBOX_STORAGE_KEY=
# Redirect: http://127.0.0.1:3000/api/inbox-connection/callback
